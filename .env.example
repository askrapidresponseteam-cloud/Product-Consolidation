# Copy to .env and `set -a; . ./.env; set +a` (or use your process manager's env).
PORT=8080
HOST=0.0.0.0

# How often every store is re-crawled (full: feed + collections + sitemap backfill)
REFRESH_MINUTES=20
PAUSE_MS=400            # gap between requests to one store; raise if you get 429s
CRAWL_CONCURRENCY=3     # stores crawled in parallel
DEEP=true               # also walk every collection
SITEMAP_BACKFILL=true   # fetch anything only the sitemap lists

# Product drawer re-reads the store live; cap per product
LIVE_DETAIL_TTL_SEC=60

# Keep last live crawl on disk so restarts serve instantly while re-crawling.
# Set false to start empty every time.
DISK_CACHE=true
DATA_DIR=./data

# API guards
RATE_LIMIT_PER_MINUTE=240
ALLOWED_ORIGINS=          # comma-separated, only if the UI is served from another host
TRUST_PROXY=false         # true behind nginx / a load balancer
ADMIN_TOKEN=              # set to enable POST /api/admin/refresh and GET /api/admin/status

# Point a store at another host (e.g. a local mock): key=host[,key=host]
# STORE_OVERRIDES=zigly=localhost:9100
