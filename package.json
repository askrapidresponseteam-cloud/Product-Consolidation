{
  "name": "theshelf",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Six-store pet catalogue: like-for-like matching, effective-price engine, faceted browse.",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test tools build e2e",
    "build": "node build/compose.mjs",
    "build:min": "node build/compose.mjs && node build/harden.mjs",
    "audit:matches": "node tools/audit-matches.mjs",
    "check:collision": "node tools/collision.mjs",
    "e2e": "node e2e/run.mjs",
    "verify": "npm run lint && npm run test && npm run build:min && npm run e2e && npm run check:collision"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^26.0.0",
    "terser": "^5.37.0",
    "vitest": "^3.0.0"
  }
}
